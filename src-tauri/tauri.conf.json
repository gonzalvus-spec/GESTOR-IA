{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GestorIA",
  "version": "0.1.0",
  "identifier": "com.gestoria.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run build:backend && npm run dev",
    "beforeBuildCommand": "npm run build:backend && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "GestorIA - Visor con Gestos",
        "width": 1100,
        "height": 750,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      },
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "hand_landmarker.task",
      "bin/backend_server"
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
